{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "BuiltBlock",
  "colors": {
    "primary": "#ef7025",
    "light": "#eec9bc",
    "dark": "#4fa1ab"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "introduction",
              "quickstart",
              "concepts"
            ]
          },
          {
            "group": "Product",
            "pages": [
              "product/desk",
              "product/model",
              "product/explore",
              "product/settings"
            ]
          },
          {
            "group": "Sources",
            "pages": [
              "sources/overview",
              "sources/hubspot",
              "sources/gong",
              "sources/granola",
              "sources/gmail",
              "sources/slack",
              "sources/google-calendar"
            ]
          },
          {
            "group": "MCP",
            "pages": [
              "mcp/overview",
              "mcp/connect",
              "mcp/ask",
              "mcp/run-account",
              "mcp/intake"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction",
              "api-reference/authentication",
              "api-reference/errors"
            ]
          },
          {
            "group": "Accounts",
            "openapi": "openapi.json",
            "pages": [
              "GET /v1/accounts",
              "POST /v1/accounts",
              "GET /v1/accounts/resolve",
              "GET /v1/accounts/{id}/state",
              "PATCH /v1/accounts/{id}"
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    { "source": "/authentication", "destination": "/api-reference/authentication" },
    { "source": "/platform/overview", "destination": "/product/desk" },
    { "source": "/platform/projects", "destination": "/product/model" },
    { "source": "/platform/integrations", "destination": "/sources/overview" },
    { "source": "/platform/settings", "destination": "/product/settings" },
    { "source": "/mcp/setup", "destination": "/mcp/connect" },
    { "source": "/mcp/tools", "destination": "/mcp/overview" },
    { "source": "/mcp/resources", "destination": "/mcp/overview" },
    { "source": "/guides/first-integration", "destination": "/quickstart" },
    { "source": "/guides/webhooks", "destination": "/introduction" },
    { "source": "/guides/ai-assistants", "destination": "/mcp/connect" },
    { "source": "/api-reference/projects", "destination": "/api-reference/introduction" },
    { "source": "/api-reference/integrations", "destination": "/sources/overview" },
    { "source": "/api-reference/webhooks", "destination": "/api-reference/introduction" },
    { "source": "/api-reference/users", "destination": "/api-reference/introduction" }
  ],
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@builtblock.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.builtblock.com"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/builtblock",
      "github": "https://github.com/builtblock"
    }
  }
}
